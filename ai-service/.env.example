# Same URI as server/.env. The database is the name in the path (mongodb://host/<db>)
MONGODB_URI=mongodb://localhost:27017/luxeai
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:5001"]

# Optional. Read by docker compose (this file must be named .env, in the project root).
# Leave it unset to use the local MongoDB container
# DOCKER_MONGODB_URI=mongodb+srv://user:password@cluster0.xxxx.mongodb.net/your_db
